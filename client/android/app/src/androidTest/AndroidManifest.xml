<?xml version="1.0" encoding="utf-8"?>
<!--
  Test APK components of the WP05 service tests: "another VPN app" for
  T-A09. They belong to the test package, so they run in its own process with
  its own uid and VPN consent, separate from the instrumented app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="phpvpn.android.service.RivalVpnActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="phpvpn.android.service.RivalVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
