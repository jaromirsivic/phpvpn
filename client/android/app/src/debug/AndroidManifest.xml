<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only activities (WP07): the component catalog and the route
     switcher used for screenshots and manual checks. Exported so that
     `adb shell am start -n` can open them; release builds do not contain them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".debug.CatalogActivity"
            android:exported="true"
            android:label="@string/debug_catalog_title" />
        <activity
            android:name=".debug.DebugRouteActivity"
            android:exported="true"
            android:label="@string/debug_routes_title" />
    </application>

</manifest>
