# Apache configuration for the directory that contains phpvpn.php.
# Copy this file next to phpvpn.php and rename it to .htaccess.
#
# phpvpn.php writes an equivalent deny rule into QUEUE_ROOT itself, but that is
# only defence in depth. The real protection is putting QUEUE_ROOT outside the
# document root, which no .htaccess can be lost or overridden for.

# phpvpn.php serves plain HTTP and HTTPS identically, so these rules add no
# redirect. Add TLS in front of PHP if you need it, but never make it a
# precondition for reaching phpvpn.php.

# --- Never serve the queue, even if QUEUE_ROOT ends up under the web root ----
<IfModule mod_authz_core.c>
    <DirectoryMatch "phpvpn(/|$)">
        Require all denied
    </DirectoryMatch>
</IfModule>

# --- Never serve queue artefacts, whatever directory they end up in ----------
# json is on the list because of QUEUE_ROOT/stats.json. Only phpvpn.php is meant
# to be served from this directory, so nothing legitimate is lost.
<FilesMatch "\.(data|sending|writing|error|stat|lock|bin|log|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- No directory listing ----------------------------------------------------
Options -Indexes

# --- Do not advertise more than necessary ------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header unset X-Powered-By
</IfModule>
